# Zig: build output, fetched packages, and caches
zig-out/
zig-pkg/
.zig-cache/

# Python bytecode
__pycache__/

# Local development material
/data/
/plan/
/ref/
/tmp/

# Peer tools: recipes and pins are tracked; installs and their state are local
/tools/archive/
/tools/bin/
/tools/venv/
/tools/.local/

# Benchmarks: each feature's run.sh, generated README.md, and the PNG figures
# it shows are tracked; corpus data, shared builds, raw results, and the
# development SVG figures are local
/bench/data/
/bench/cache/
/bench/*/results/*
!/bench/*/results/figures/
/bench/*/results/figures/*.svg
/wiki/assets/*.svg
