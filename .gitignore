# Zig build artifacts
.zig*
zig*

# Tool inputs are tracked; installed and archived state is local
tools/archive/
tools/bin/
tools/venv/
tools/.local/

# Development related folders
data/
plan/
ref/
tmp/

# Exceptions
!tests/data/
!tests/data/**

# Python
__pycache__/

# Bench: downloads, generated fixtures, raw zebrac JSON (keep figures for REPORT.md)
bench/*/data/**
bench/*/results/*
!bench/*/results/figures/
bench/shared/cache/**
bench/shared/data/**
